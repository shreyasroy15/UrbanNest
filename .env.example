# UrbanNest N8N Configuration Example
# Copy this file to .env and populate with your own N8N Webhook URLs

# Webhook URL for Query Form submission
VITE_N8N_QUERY_WEBHOOK_URL=https://primary-production.up.railway.app/webhook/your-query-uuid

# Webhook URL for AI Chatbot interface (handles chat payload: message, sessionId, etc.)
VITE_N8N_CHATBOT_URL=https://primary-production.up.railway.app/webhook/your-chatbot-uuid
